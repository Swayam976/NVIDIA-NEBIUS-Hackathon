# Get this from the Token Factory console: https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Nebius Token Factory is OpenAI-API-compatible
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com

# Pick a Nemotron model slug from the Token Factory model catalog.
# Use a cheaper/faster tier for routine calls, a reasoning tier for
# the module modifier and spec drafting if you want more careful output.
NEBIUS_MODEL=nvidia/nemotron-3-super

# Where your actual RTL repos live, so tools can read/edit real files.
# Point these at your local checkouts.
RISCV_REPO_PATH=./repos/riscv-core
SIMT_GPU_CORE_PATH=./repos/simt-gpu-core
NPU_REPO_PATH=./repos/micro-npu
GEMM_REPO_PATH=./repos/mxint8-gemm
